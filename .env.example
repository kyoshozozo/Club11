# ANTHROPIC_API_KEY: az AI csapos (Claude Haiku 4.5) kulcsa.
# A console.anthropic.com oldalon hozható létre. Soha ne írd be a valódi kulcsot
# ebbe a fájlba vagy a kódba – a tárhely beállításainál (pl. Secrets) add meg.
# Ha nincs beállítva, a csapos a beépített tartalék válaszokkal működik.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP_USER / SMTP_PASS: a foglalási e-mailek küldéséhez.
# Gmail esetén: SMTP_USER a Gmail cím, SMTP_PASS a Google fiókban létrehozott
# 16 jegyű "alkalmazásjelszó" (NEM a sima Gmail jelszó). Soha ne írd be ide a valódit!
# Ha nincs beállítva, a foglalás ugyanúgy mentődik, csak e-mail nem megy ki.
SMTP_USER="club11buda@gmail.com"
SMTP_PASS="MY_GMAIL_APP_PASSWORD"
# Nem kötelező: ide megy az értesítő (alapból club11buda@gmail.com)
# BOOKING_NOTIFY_EMAIL="club11buda@gmail.com"

# ADMIN_PASSWORD: A galéria admin felület jelszava.
# Soha ne írd be a valódi jelszót ebbe a fájlba vagy a kódba!
# Ha nincs beállítva, az admin belépés le van tiltva.
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"
